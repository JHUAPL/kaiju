{
    "version": "0.0.0",
    "simulation": {
        "job_name": {
            "LEVEL": "BASIC",
            "prompt": "Name to use for PBS job(s)",
            "default": "geospace",
            "type": "name"
        },
        "bcwind_available": {
            "LEVEL": "BASIC",
            "prompt": "Do you have an existing solar wind file to use?",
            "default": "N",
            "valids": [
                "Y",
                "y",
                "N",
                "n"
            ],
            "type": "yn"
        },
        "bcwind_file": {
            "LEVEL": "BASIC",
            "prompt": "Name of solar wind file to use",
            "default": "bcwind.h5",
            "type": "file"
        },
        "start_date": {
            "LEVEL": "BASIC",
            "prompt": "Start date for simulation (yyyy-mm-ddThh:mm:ss)",
            "default": "2001-06-01T23:00:00",
            "type": "iso"
        },
        "stop_date": {
            "LEVEL": "BASIC",
            "prompt": "Stop date for simulation (yyyy-mm-ddThh:mm:ss)",
            "default": "2001-06-02T01:00:00",
            "type": "iso"
        },
        "use_segments": {
            "LEVEL": "BASIC",
            "prompt": "Do you want to split your job into multiple segments?",
            "default": "N",
            "valids": [
                "Y",
                "y",
                "N",
                "n"
            ],
            "type": "yn"
        },
        "segment_duration": {
            "LEVEL": "BASIC",
            "prompt": "Segment length in simulated seconds",
            "NOTE": "Asked after the machine, queue and walltime. Standalone: each segment has to fit the walltime at the machine's rate (config/machines.yaml rates.gr, with a safety margin); the default is the largest whole-hour length that fits, at most the run length. Under engage the coupled segment is engage's, asked there in seconds (whole hours).",
            "type": "float",
            "min": 0,
            "exclusive_min": true
        },
        "gamera_grid_type": {
            "LEVEL": "BASIC",
            "prompt": "GAMERA grid type",
            "default": "Q",
            "valids": [
                "D",
                "Q",
                "O",
                "H"
            ],
            "type": "str"
        },
        "gamera_grid_inner_radius": {
            "LEVEL": "INTERMEDIATE",
            "prompt": "GAMERA grid inner radius (in Earth radii)",
            "default": "2.0",
            "type": "float",
            "min": 0,
            "exclusive_min": true
        },
        "gamera_grid_outer_radius": {
            "LEVEL": "INTERMEDIATE",
            "prompt": "GAMERA sunward outer radius (in Earth radii)",
            "default": "30.0",
            "type": "float",
            "min": 0,
            "exclusive_min": true
        },
        "hpc_system": {
            "LEVEL": "BASIC",
            "prompt": "Name of HPC system",
            "NOTE": "valids = the machines in config/machines.yaml; the default is the machine this host resolves to. derecho is tested; aitken is untested; perlmutter is experimental and untested; linux is a plain host without a scheduler.",
            "default": "derecho",
            "valids": [
                "derecho",
                "aitken",
                "linux",
                "perlmutter"
            ],
            "type": "str"
        },
        "node_type": {
            "LEVEL": "INTERMEDIATE",
            "prompt": "Compute node type",
            "NOTE": "Asked only on a machine with several node types (config/machines.yaml node_types, e.g. aitken milan|rome|cascade); valids and default come from machines.yaml. Sets the job's node model and cores per node.",
            "default": null,
            "type": "str"
        }
    },
    "pbs": {
        "_common": {
            "account_name": {
                "LEVEL": "BASIC",
                "prompt": "PBS account name",
                "NOTE": "No shared default (the account is per user). Required on a machine whose machines.yaml sets account_required (derecho): a blank answer is asked again and a replayed JSON without it is refused. Not asked on a machine that takes no account line (aitken charges by group_list).",
                "type": "name"
            },
            "run_directory": {
                "LEVEL": "BASIC",
                "prompt": "Run directory",
                "default": ".",
                "type": "path",
                "NOTE": "The run segments' decks, jobs, logs, output and restarts are in the run directory; the GR spin-up / warm-up (<job>-SPINUP, <job>-WARMUP-NN) runs in its gr_spinup/ subdirectory and reads the grid, wind and RAIJU files through relative links (../<file>). <job>_pbs.sh submits every job from its own directory; segment 01 hard-links the lead-in's restart set from gr_spinup/ first. Paths inside the run directory are relative; the kaiju install / build, a user wind file and each lead-in job's cd to gr_spinup/ are absolute. makeitso_parameters.json records run_directory '.', read relative to the JSON's own directory: after moving a run directory, regenerate from inside it with makeitso.py --clobber -o makeitso_parameters.json."
            },
            "kaiju_install_directory": {
                "LEVEL": "BASIC",
                "prompt": "Path to kaiju installation",
                "type": "path"
            },
            "kaiju_build_directory": {
                "LEVEL": "BASIC",
                "prompt": "Path to kaiju build directory",
                "type": "path"
            },
            "num_segments": {
                "LEVEL": "EXPERT",
                "NOTE": "Derived from the run length and segment_duration; never asked.",
                "prompt": null,
                "default": "1",
                "type": "int",
                "min": 1
            }
        },
        "_machine": {
            "queue": {
                "LEVEL": "BASIC",
                "prompt": "PBS queue name",
                "default": "main",
                "valids": [
                    "develop",
                    "main"
                ],
                "type": "str"
            },
            "job_priority": {
                "LEVEL": "BASIC",
                "prompt": "Job priority",
                "default": "economy",
                "valids": [
                    "regular",
                    "economy"
                ],
                "type": "str"
            },
            "walltime": {
                "LEVEL": "BASIC",
                "prompt": "Requested wall time for each PBS job segment (HH:MM:SS)",
                "default": "01:00:00",
                "type": "hms"
            },
            "mpiprocs": {
                "LEVEL": "EXPERT",
                "prompt": "Number of MPI ranks per node",
                "default": "2",
                "type": "int",
                "min": 1
            },
            "ompthreads": {
                "LEVEL": "EXPERT",
                "prompt": "Number of OMP threads per MPI rank",
                "default": "64",
                "type": "int",
                "min": 1,
                "NOTE": "Default: the node type's cores per node / mpiprocs (config/machines.yaml)"
            },
            "num_helpers": {
                "LEVEL": "EXPERT",
                "prompt": "Number of helper nodes",
                "default": {
                    "D": "0",
                    "Q": "2",
                    "O": "4",
                    "H": "8"
                },
                "type": "int",
                "min": 0
            },
            "helper_mpiprocs": {
                "LEVEL": "EXPERT",
                "prompt": "Number of MPI ranks per helper node",
                "default": "1",
                "type": "int",
                "min": 1
            },
            "helper_ompthreads": {
                "LEVEL": "EXPERT",
                "prompt": "Number of OMP threads per helper node",
                "default": "128",
                "type": "int",
                "min": 1,
                "NOTE": "Default: the node type's cores per node / helper_mpiprocs (config/machines.yaml)"
            },
            "group_list": {
                "LEVEL": "BASIC",
                "prompt": "PBS group list",
                "default": null,
                "type": "name"
            },
            "local_modules": {
                "LEVEL": "EXPERT",
                "prompt": "Commands to add local module PATH",
                "default": [
                    null
                ],
                "type": "lines"
            }
        }
    },
