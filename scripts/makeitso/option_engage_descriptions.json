            "modules": {
                "LEVEL": "EXPERT",
                "prompt": "Modules to load",
                "default": [
                    "ncarenv/23.09",
                    "cmake/3.26.3",
                    "craype/2.7.31",
                    "cray-mpich/8.1.27",
                    "ncarcompilers/1.0.0",
                    "mkl/2023.2.0",
                    "hdf5-mpi/1.12.2",
                    "netcdf-mpi/4.9.2",
                    "esmf/8.6.0",
                    "conda"
                ]
            }
        },
        "pleiades": {
            "modules": {
                "LEVEL": "EXPERT",
                "prompt": "Modules to load",
                "default": [
                    "nas",
                    "pkgsrc/2023Q3",
                    "comp-intel/2020.4.304",
                    "mpi-hpe/mpt.2.28_25Apr23_rhel87",
                    "szip/2.1.1",
                    "hdf4/4.2.12",
                    "hdf5/1.8.18_mpt",
                    "netcdf/4.4.1.1_mpt"
                ]
            }
        }
    }
}