module testGridLocator

    use testHelper
    use kdefs, only : TINY

    use shellGrid
    use shellUtils
    !use shellInterp

    implicit none

    integer, parameter :: Npnt = 50
    integer, parameter :: Noob = 3 ! Number of points to leave out of ShellGrid bounds on lower and upper theta dim
    integer, parameter :: Nsamples = (Npnt-1)*4
    real(rp), parameter :: dTh = 0.5*PI / (Npnt-1)
    real(rp), parameter :: dPh = 2.0*PI / (Npnt-1)
    real(rp), dimension(4) :: subPnts = [0.01, 0.49, 0.51, 0.99] 
    real(rp), dimension(Nsamples) :: pntsTheta, pntsPhi
    integer, dimension(Nsamples) :: idxTh_cc, idxPh_cc
            !! These are the indices that each pntsTheta/pntsPhi should evaluate to when finding cell centers
    integer, dimension(Nsamples) :: idxTh_corner, idxPh_corner 
            !! These are the indices that each pntsTheta/pntsPhi should evaluate to when finding cell corners
    type(ShellGrid_T) :: sh
    character(len=strLen) :: checkMessage

    contains

    @before
	subroutine setup()
        real(rp), dimension(Npnt) :: thetas, phis
        integer :: i,j

        !dth = 0.5*PI / (Npnt-1)
        !dph = 2.0*PI / (Npnt-1)

        do i=1,Npnt
            thetas(i) = (i-1)*dTh
        enddo

        do j=1,Npnt
            phis(j) = (j-1)*dPh
        enddo

        ! Reduce shellgrid theta range to test going off grid
	    call GenShellGrid(sh, thetas(1+Noob:Npnt-Noob), phis,'shgrTest_loc', radO=1.1_rp)

        ! init interp sample points
        do i=1,Nsamples,4
            pntsTheta(i:i+3) = thetas(i/4+1) + (dTh * subPnts)
            pntsPhi  (i:i+3) = phis  (i/4+1) + (dPh * subPnts)
        enddo

        ! Set up idx arrays to match what we expect gridLoc routines to return w.r.t. ShellGrid dimensions
        ! i.e. need to offset theta dims by the same amount we excluded from ShellGrid
        do i=1,Nsamples,4
            idxTh_cc(i:i+3) = i/4+1 - Noob
            idxPh_cc(i:i+3) = i/4+1
        enddo

        idxTh_corner(:2) = 1 - Noob
        idxPh_corner(:2) = 1
        idxTh_corner(Nsamples-1:) = Npnt - Noob
        idxPh_corner(Nsamples-1:) = Npnt
        do i=3,Nsamples-2,4
            idxTh_corner(i:i+3) = i/4+2 - Noob
            idxPh_corner(i:i+3) = i/4+2
        enddo

	end subroutine setup


	@after
	subroutine teardown()
        call deallocShellGrid(sh)	    
    end subroutine teardown

    @test
    subroutine testGridLoc_CC()
        !! Tests the functions responsible for finding the index of the point closest to point (t,p)
        !! In the case where we have a cell-centered variable
        integer :: testLocI, testLocJ
        integer :: i
        real(rp) :: thetaOut, phiOut


        ! Get the values we're here to test
        do i=1,Nsamples
            call getSGCellILoc(sh, pntsTheta(i), testLocI, tLocO=thetaOut)
            call getSGCellJLoc(sh, pntsPhi  (i), testLocJ, pLocO=phiOut)

            write (checkMessage,*) "Got theta index wrong."
            @assertEqual(testLocI, idxTh_cc(i), trim(checkMessage))
            !continue ! These obviously do nothing but if I don't include them my syntax highlighting breaks which is absolutely unacceptable
            write (checkMessage,*) "Got phi index wrong."
            @assertEqual(testLocJ, idxPh_cc(i), trim(checkMessage))
            write (checkMessage,*) "Got theta value wrong."
            @assertLessThanOrEqual(abs(thetaOut-pntsTheta(i)), dTh, trim(checkMessage))
            write (checkMessage,*) "Got phi value wrong."
            @assertLessThanOrEqual(abs(phiOut-pntsPhi(i)), dPh, trim(checkMessage))
        enddo
    end subroutine


    @test
    subroutine testGridLoc_corner()
        !! Tests the functions responsible for finding the index of the point closest to point (t,p)
        !! In the case where we have a corner-centered variable
        integer :: testLocI, testLocJ
        integer :: i
        real(rp) :: thetaOut, phiOut

        ! Get the values we're here to test
        do i=1,Nsamples
            call getSGCellILoc(sh, pntsTheta(i), testLocI)
            call getSGCellJLoc(sh, pntsPhi  (i), testLocJ)
            call iLocCC2Corner(sh, pntsTheta(i), testLocI, tLocO=thetaOut)
            call jLocCC2Corner(sh, pntsPhi  (i), testLocJ, pLocO=phiOut)


            write (checkMessage,*) "Got theta index wrong."
            @assertEqual(testLocI, idxTh_corner(i), trim(checkMessage))
            write (checkMessage,*) "Got phi index wrong."
            @assertEqual(testLocJ, idxPh_corner(i), trim(checkMessage))
            write (checkMessage,*) "Got theta value wrong."
            @assertLessThanOrEqual(abs(thetaOut-pntsTheta(i)), dTh, trim(checkMessage))
            write (checkMessage,*) "Got phi value wrong."
            @assertLessThanOrEqual(abs(phiOut-pntsPhi(i)), dPh, trim(checkMessage))
            
        enddo
    end subroutine


    @test
    subroutine testGridLoc_thetaFace()
        !! Tests the functions responsible for finding the index of the point closest to point (t,p)
        !! In the case where we have a variable on theta faces
        integer :: testLocI, testLocJ
        integer :: i
        real(rp) :: thetaOut, phiOut

        ! Get the values we're here to test
        do i=1,Nsamples
            call getSGCellILoc(sh, pntsTheta(i), testLocI)
            call getSGCellJLoc(sh, pntsPhi  (i), testLocJ, pLocO=phiOut)
            call iLocCC2Corner(sh, pntsTheta(i), testLocI, tLocO=thetaOut)

            write (checkMessage,*) "Got theta index wrong."
            @assertEqual(testLocI, idxTh_corner(i), trim(checkMessage))
            write (checkMessage,*) "Got phi index wrong."
            @assertEqual(testLocJ, idxPh_cc(i), trim(checkMessage))
            write (checkMessage,*) "Got theta value wrong."
            @assertLessThanOrEqual(abs(thetaOut-pntsTheta(i)), dTh, trim(checkMessage))
            write (checkMessage,*) "Got phi value wrong."
            @assertLessThanOrEqual(abs(phiOut-pntsPhi(i)), dPh, trim(checkMessage))
        enddo
    end subroutine


    @test
    subroutine testGridLoc_phiFace()
        !! Tests the functions responsible for finding the index of the point closest to point (t,p)
        !! In the case where we have a variable on phi faces
        integer :: testLocI, testLocJ
        integer :: i
        real(rp) :: thetaOut, phiOut

        ! Get the values we're here to test
        do i=1,Nsamples
            call getSGCellILoc(sh, pntsTheta(i), testLocI, tLocO=thetaOut)
            call getSGCellJLoc(sh, pntsPhi  (i), testLocJ)
            call jLocCC2Corner(sh, pntsPhi  (i), testLocJ, pLocO=phiOut)

            write (checkMessage,*) "Got theta index wrong."
            @assertEqual(testLocI, idxTh_cc(i), trim(checkMessage))
            write (checkMessage,*) "Got phi index wrong."
            @assertEqual(testLocJ, idxPh_corner(i), trim(checkMessage))
            write (checkMessage,*) "Got theta value wrong."
            @assertLessThanOrEqual(abs(thetaOut-pntsTheta(i)), dTh, trim(checkMessage))
            write (checkMessage,*) "Got phi value wrong."
            @assertLessThanOrEqual(abs(phiOut-pntsPhi(i)), dPh, trim(checkMessage))
        enddo
    end subroutine


    @test
    subroutine testPeriodicJLocReturnsActiveIndex()
        type(ShellGrid_T) :: nonuniformSh
        real(rp), dimension(5) :: theta
        real(rp), dimension(6) :: phi
        integer :: jLoc

        theta = [0.2_rp, 0.4_rp, 0.7_rp, 1.0_rp, 1.3_rp]
        phi = [0.0_rp, 0.12_rp, 0.5_rp, 1.3_rp, 3.4_rp, 2.0_rp*PI]
        call GenShellGrid(nonuniformSh, theta, phi, 'shgrNonuniformPeriodic', radO=1.1_rp)

        call getSGCellJLoc(nonuniformSh, 0.0_rp, jLoc)
        @assertEqual(nonuniformSh%js, jLoc, "getSGCellJLoc should return active js at periodic lower boundary")

        call getSGCellJLoc(nonuniformSh, 2.0_rp*PI, jLoc)
        @assertEqual(nonuniformSh%js, jLoc, "getSGCellJLoc should wrap 2pi to active js")

        call getSGCellJLoc(nonuniformSh, -TINY, jLoc)
        @assertEqual(nonuniformSh%je, jLoc, "getSGCellJLoc should wrap slightly negative phi to active je")

        call deallocShellGrid(nonuniformSh)
    end subroutine testPeriodicJLocReturnsActiveIndex


    @test
    subroutine testPeriodicWrapHelpers()
        type(ShellGridVar_T) :: wrapVarCC
        type(ShellGridVar_T) :: wrapVarCorner
        type(ShellGridVar_T) :: wrapVarFaceTheta
        type(ShellGridVar_T) :: wrapVarFacePhi
        integer :: i, j, jExpected

        @assertEqual(sh%je   , getSGJ_periodic(sh, sh%js-1), "getSGJ_periodic(js-1) failed")
        @assertEqual(sh%je-1 , getSGJ_periodic(sh, sh%js-2), "getSGJ_periodic(js-2) failed")
        @assertEqual(sh%js   , getSGJ_periodic(sh, sh%je+1), "getSGJ_periodic(je+1) failed")
        @assertEqual(sh%js+1 , getSGJ_periodic(sh, sh%je+2), "getSGJ_periodic(je+2) failed")

        call initShellVar(sh, SHGR_CC, wrapVarCC)
        wrapVarCC%data = -999.0_rp
        do j=sh%js,sh%je
            do i=wrapVarCC%isv,wrapVarCC%iev
                wrapVarCC%data(i,j) = 1000.0_rp*i + j
            enddo
        enddo
        call wrapJ_SGV(sh, wrapVarCC)

        do j=sh%jsg,sh%js-1
            jExpected = sh%je - sh%Nge + 1 + (j - sh%jsg)
            do i=wrapVarCC%isv,wrapVarCC%iev
                @assertEqual(wrapVarCC%data(i,jExpected), wrapVarCC%data(i,j), "wrapJ_SGV CC: west ghost mismatch")
            enddo
        enddo
        do j=sh%je+1,sh%jeg
            jExpected = sh%js + (j - (sh%je+1))
            do i=wrapVarCC%isv,wrapVarCC%iev
                @assertEqual(wrapVarCC%data(i,jExpected), wrapVarCC%data(i,j), "wrapJ_SGV CC: east ghost mismatch")
            enddo
        enddo

        call initShellVar(sh, SHGR_FACE_THETA, wrapVarFaceTheta)
        wrapVarFaceTheta%data = -999.0_rp
        do j=sh%js,sh%je
            do i=wrapVarFaceTheta%isv,wrapVarFaceTheta%iev
                wrapVarFaceTheta%data(i,j) = 1000.0_rp*i + j
            enddo
        enddo
        call wrapJ_SGV(sh, wrapVarFaceTheta)

        do j=sh%jsg,sh%js-1
            jExpected = sh%je - sh%Nge + 1 + (j - sh%jsg)
            do i=wrapVarFaceTheta%isv,wrapVarFaceTheta%iev
                @assertEqual(wrapVarFaceTheta%data(i,jExpected), wrapVarFaceTheta%data(i,j), "wrapJ_SGV face-theta: west ghost mismatch")
            enddo
        enddo
        do j=sh%je+1,sh%jeg
            jExpected = sh%js + (j - (sh%je+1))
            do i=wrapVarFaceTheta%isv,wrapVarFaceTheta%iev
                @assertEqual(wrapVarFaceTheta%data(i,jExpected), wrapVarFaceTheta%data(i,j), "wrapJ_SGV face-theta: east ghost mismatch")
            enddo
        enddo

        call initShellVar(sh, SHGR_CORNER, wrapVarCorner)
        wrapVarCorner%data = -999.0_rp
        do j=sh%js,sh%je+1
            do i=wrapVarCorner%isv,wrapVarCorner%iev
                wrapVarCorner%data(i,j) = 1000.0_rp*i + j
            enddo
        enddo
        call wrapJ_SGV(sh, wrapVarCorner)

        do j=sh%jsg,sh%js
            jExpected = sh%je - sh%Nge + 1 + (j - sh%jsg)
            do i=wrapVarCorner%isv,wrapVarCorner%iev
                @assertEqual(wrapVarCorner%data(i,jExpected), wrapVarCorner%data(i,j), "wrapJ_SGV corner: west ghost mismatch")
            enddo
        enddo
        do j=sh%je+1,sh%jeg+1
            jExpected = sh%js + (j - (sh%je+1))
            do i=wrapVarCorner%isv,wrapVarCorner%iev
                @assertEqual(wrapVarCorner%data(i,jExpected), wrapVarCorner%data(i,j), "wrapJ_SGV corner: east ghost mismatch")
            enddo
        enddo

        call initShellVar(sh, SHGR_FACE_PHI, wrapVarFacePhi)
        wrapVarFacePhi%data = -999.0_rp
        do j=sh%js,sh%je+1
            do i=wrapVarFacePhi%isv,wrapVarFacePhi%iev
                wrapVarFacePhi%data(i,j) = 1000.0_rp*i + j
            enddo
        enddo
        call wrapJ_SGV(sh, wrapVarFacePhi)

        do j=sh%jsg,sh%js
            jExpected = sh%je - sh%Nge + 1 + (j - sh%jsg)
            do i=wrapVarFacePhi%isv,wrapVarFacePhi%iev
                @assertEqual(wrapVarFacePhi%data(i,jExpected), wrapVarFacePhi%data(i,j), "wrapJ_SGV face-phi: west ghost mismatch")
            enddo
        enddo
        do j=sh%je+1,sh%jeg+1
            jExpected = sh%js + (j - (sh%je+1))
            do i=wrapVarFacePhi%isv,wrapVarFacePhi%iev
                @assertEqual(wrapVarFacePhi%data(i,jExpected), wrapVarFacePhi%data(i,j), "wrapJ_SGV face-phi: east ghost mismatch")
            enddo
        enddo
    end subroutine


    @test
    subroutine testGetSGCellILoc_exactGhostEdges()
        integer :: iLoc

        call getSGCellILoc(sh, sh%minGTheta, iLoc)
        @assertEqual(sh%isg, iLoc, "getSGCellILoc(minGTheta) should return isg")

        call getSGCellILoc(sh, sh%maxGTheta, iLoc)
        @assertEqual(sh%ieg, iLoc, "getSGCellILoc(maxGTheta) should return ieg")
    end subroutine

end module testGridLocator
